# Copy to deploy/.env on the server (it's not in git) and fill in. docker compose reads it for the API.

# Where the app lives, for the links in emails
PUBLIC_URL=https://spotter.tamairnv.co.uk

# Sending email (confirm your address, reset your password). Any SMTP works; e.g. Gmail with an
# app password: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
# Without SMTP_HOST, accounts stay switched off (devices can still link with a code).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FPV Spot Finder <you@gmail.com>

# Cloudflare Turnstile (dash.cloudflare.com > Turnstile > add site spotter.tamairnv.co.uk, "Managed")
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Verified accounts with these emails see the Stats page and can hide reviews (comma-separated)
SPOTTER_ADMIN_EMAILS=
