# deploy/.env on the server (not in git; chmod 600). docker compose reads it for the API.
# The four secrets live in keys.tamairnv.co.uk under service "fpv-spotter"; copy them in here.

# Gmail to send confirm / reset emails from, and a Gmail app password (not the normal one)
SMTP_USER=
SMTP_PASS=

# Cloudflare Turnstile for spotter.tamairnv.co.uk (dashboard > Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Verified accounts with these emails see the Stats page and can hide reviews (comma-separated)
SPOTTER_ADMIN_EMAILS=

# Optional overrides (defaults shown)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# MAIL_FROM=FPV Spot Finder <SMTP_USER>
# PUBLIC_URL=https://spotter.tamairnv.co.uk
